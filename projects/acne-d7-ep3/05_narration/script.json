{
  "name": "acne-d7-ep3",
  "scenes": [
    {
      "no": 1,
      "type": "hook",
      "voice": "면접 전날 밤, 시연 씨는 뭘 했을까요?",
      "chars": 22
    },
    {
      "no": 2,
      "type": "item",
      "voice": "첫째, 하루 두 번 미온수로 손끝만 써서 부드럽게 씻었어요.",
      "chars": 33
    },
    {
      "no": 3,
      "type": "item",
      "voice": "둘째, 물기가 남은 피부에 오일프리 보습제를 발랐어요.",
      "chars": 30
    },
    {
      "no": 4,
      "type": "item",
      "voice": "셋째, 짜지도 긁지도 않고 새 제품도 바꾸지 않았어요.",
      "chars": 30
    },
    {
      "no": 5,
      "type": "item",
      "voice": "면접 당일, 트러블이 다 사라지진 않았어요. 그래도 시연 씨는 웃으며 들어갔어요.",
      "chars": 45
    },
    {
      "no": 6,
      "type": "outro",
      "voice": "많이 아프고 붉다면 피부과 상담도 좋은 방법이에요. 저장하고 팔로우하세요.",
      "chars": 41
    }
  ],
