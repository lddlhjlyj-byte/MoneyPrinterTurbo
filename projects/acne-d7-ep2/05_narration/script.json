{
  "name": "acne-d7-ep2",
  "scenes": [
    {
      "no": 1,
      "type": "hook",
      "voice": "빨리 없애려고 짰는데 왜 더 심해질까요?",
      "chars": 22
    },
    {
      "no": 2,
      "type": "item",
      "voice": "면접까지 엿새. 시연 씨는 조급했어요. 트러블을 손으로 짜고, 세안도 하루 네 번 했어요.",
      "chars": 50
    },
    {
      "no": 3,
      "type": "item",
      "voice": "노랑이가 말했어요. 손으로 짜면 더 붉어지고, 흉터가 남을 수도 있어요.",
      "chars": 40
    },
    {
      "no": 4,
      "type": "item",
      "voice": "잦은 세안과 문지르기는 피부를 약하게 해요. 트러블은 안 씻어서 생기는 게 아니에요.",
      "chars": 47
    },
    {
      "no": 5,
      "type": "item",
      "voice": "시연 씨는 화장대 제품부터 치웠어요. 면접까지 닷새, 이제 뭘 해야 할까요?",
      "chars": 42
    },
    {
      "no": 6,
      "type": "outro",
      "voice": "저장하고 다음 편에서 확인하세요.",
      "chars": 18
    }
  ],
  "total_chars": 219
