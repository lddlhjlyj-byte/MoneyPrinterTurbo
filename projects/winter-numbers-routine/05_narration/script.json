{
  "name": "winter-numbers-routine",
  "scenes": [
    {
      "no": 1,
      "type": "hook",
      "voice": "겨울만 되면 피부가 당기나요? 세안 후 3분 안에 보습제를 바르고 계신가요?",
      "chars": 42
    },
    {
      "no": 2,
      "type": "why",
      "voice": "세안 후 피부 수분은 빠르게 날아갑니다. 겨울엔 찬 공기와 난방 때문에 더 건조해지기 쉽습니다.",
      "chars": 53
    },
    {
      "no": 3,
      "type": "signs",
      "voice": "세안 후 피부가 당기고, 잔주름이 도드라지고, 화장이 들뜬다면 건조 신호일 수 있습니다.",
      "chars": 49
    },
    {
      "no": 4,
      "type": "title",
      "voice": "기억할 숫자는 네 가지입니다. 하나씩 알려드릴게요.",
      "chars": 28
    },
    {
      "no": 5,
      "type": "item",
      "voice": "샤워는 미지근한 물로, 5분에서 10분 안에 끝내세요.",
      "chars": 30
    },
    {
      "no": 6,
      "type": "item",
      "voice": "세안이나 샤워 후, 3분 안에 보습제를 바르세요.",
      "chars": 27
    },
    {
      "no": 7,
      "type": "item",
      "voice": "실내 온도는 18도에서 22도 사이로 맞춰 보세요.",
      "chars": 28
    },
    {
      "no": 8,
      "type": "item",
      "voice": "실내 습도는 40에서 60퍼센트를 목표로 관리해 보세요.",
      "chars": 31
    },
    {
      "no": 9,
      "type": "summary",
      "voice": "정리하면, 5에서 10분, 3분, 18에서 22도, 습도 40에서 60퍼센트입니다.",
      "chars": 46
    },
    {
      "no": 10,
      "type": "outro",
      "voice": "저장해 두고 오늘 밤부터 하나씩 해 보세요. 도움이 됐다면 팔로우해 주세요.",
      "chars": 42
    }
  ],
  "total_chars": 376
}